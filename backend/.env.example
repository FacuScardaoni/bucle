# Copiá este archivo como .env para desarrollo local. El .env NUNCA se sube al repo.

# Cadena de conexión de PostgreSQL (Neon). Si se deja vacía, la API usa datos en memoria.
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require

# Puerto local (Render lo asigna automáticamente en producción)
PORT=3000

# Origen permitido para el frontend (URL de Netlify). En desarrollo puede ser *
CORS_ORIGIN=*

# Solo para `npm run test:db`: una base de PRUEBA que se vacía en cada ejecución. Nunca la de producción.
# DATABASE_URL_TEST=postgres://usuario:clave@host/bucle_test?sslmode=require
